{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build mapradar",
      "type": "shell",
      "command": "C:/msys64/mingw64/bin/gcc.exe",
      "args": [
        "-g", "mapradar.c", "-o", "mapradar.exe", "-mwindows",
        "-lgdi32", "-lgdiplus", "-lwininet", "-lshlwapi", "-lole32", "-lm"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"],
      "detail": "Compile mapradar.c -> mapradar.exe"
    }
  ]
}